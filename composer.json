{
    "name": "greenhouse-creative/silverstripe-misdirection",
    "description": "This module allows both simple and regular expression link redirections based on customisable mappings, either hooking into a page not found or replacing the default automated URL handling.",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "link mapping",
        "mapping",
        "url",
        "page not found",
        "404",
        "http 404",
        "redirection",
        "redirect"
    ],
    "homepage": "https://github.com/solout/silverstripe-misdirection",
    "license": "BSD-3-Clause",
    "authors": [{
        "name": "Nathan Glasl",
        "email": "nathan@symbiote.com.au"
    }],
    "require": {
        "silverstripe/framework": "^6",
        "silverstripe/vendor-plugin": "^3"
    },
    "replace": {
        "nglasl/silverstripe-misdirection": "self.version"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3",
        "friendsofphp/php-cs-fixer": "^3"
    },
    "autoload": {
        "psr-4": {
            "nglasl\\misdirection\\": [
                "src/controllers/",
                "src/extensions/",
                "src/forms/",
                "src/objects/",
                "src/filters/",
                "src/services/"
            ],
            "nglasl\\misdirection\\tests\\": "tests/"
        }
    },
    "extra": {
        "expose": [
            "client"
        ]
    }
}
